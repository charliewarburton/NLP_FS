sentiment_graph <- function(df, title = "Sentiment Index over time"){
# Calculate median
median <- median(df$Sentiment.Index, na.rm = TRUE)
graph <- ggplot(df, aes(x = Report, y = Sentiment.Index)) +
geom_line() +
geom_hline(yintercept = median, linetype = "dashed", color = "grey") +
labs(title = title,
x = "Date",
y = "Sentiment Index (increasing is poorer sentiment)") +
theme_minimal()
return(graph)
}
