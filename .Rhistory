set.seed(123)
#
# df_sample <- df %>%
#   filter(Sentiment.Label == "negative" & Sentiment.Score >= 0.87 |
#            Sentiment.Label == "positive" & Sentiment.Score >= 0.60) %>%
#   filter(str_detect(Text.Chunk, regex(pattern, ignore_case = TRUE)))
# ran_ints <- sample(1:nrow(df_sample), 50)
