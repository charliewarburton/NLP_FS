#
# write.csv(df_sample, "sub_sample_label.csv", row.names = FALSE)
df_sample <- read.csv(here::here("Data", "sub_sample_label.csv"))
correa_pos <- correa_dict %>%
filter(Positive == 1) %>%
select(Word)
correa_neg <- correa_dict %>%
filter(Negative == 1) %>%
select(Word)
pos_pattern <- paste0("\\b(", paste(correa_pos$Word, collapse="|"), ")\\b")
neg_pattern <- paste0("\\b(", paste(correa_neg$Word, collapse="|"), ")\\b")
df_sample <- df_sample %>%
mutate(
Correa.Label = case_when(
str_detect(Text.Chunk, regex(pos_pattern, ignore_case = T)) ~ "positive",
str_detect(Text.Chunk, regex(neg_pattern, ignore_case = T)) ~ "negative",
TRUE ~ NA  # Assigns  NA if no match is found but shouldn't happen
)
) %>%
na.omit() # Shouldn't be any NAs but just incase
# ------------------------
# Confusion matrix
# ------------------------
all_levels <- c("positive", "negative", "none")
# Ensure both columns are factors with the same levels
df_sample$Correa.Label <- factor(df_sample$Correa.Label, levels = all_levels)
df_sample$Human.Label <- factor(df_sample$Human.Label, levels = all_levels)
# Generate the confusion matrix
cm_correa <- confusionMatrix(data = df_sample$Correa.Label,
reference = df_sample$Human.Label)
# Print the Correa results
print("--- Evaluation: Correa.Label vs Human.Label ---")
print(cm_correa)
# CBRoBERTa Confusion Matrix
df_sample$Sentiment.Label <- factor(df_sample$Sentiment.Label, levels = all_levels)
cm_cbr <- confusionMatrix(data = df_sample$Sentiment.Label,
reference = df_sample$Human.Label)
# Print the CBRoBERTa results
print("--- Evaluation: Sentiment.Label vs Human.Label ---")
print(cm_cbr)
